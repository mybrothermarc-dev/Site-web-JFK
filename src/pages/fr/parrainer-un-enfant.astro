---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import IconFeature from '../../components/IconFeature.astro';
import ProfileCard from '../../components/ProfileCard.astro';
import WebForm from '../../components/WebForm.astro';
import FormField from '../../components/FormField.astro';
import { sponsorChildContent } from '../../data/pages/sponsor-child';
import { sponsorshipTiers } from '../../data/site';
import { useTranslations } from '../../i18n/ui';
import { routeUrl } from '../../i18n/routes';
import { getCollection } from 'astro:content';

const lang = 'fr' as const;
const c = sponsorChildContent[lang];
const t = useTranslations(lang);

const children = (await getCollection('children')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout lang={lang} currentRoute="sponsorChild" title={c.seoTitle} description={c.seoDescription}>
  <Hero
    eyebrow={c.heroEyebrow}
    title={c.heroTitle}
    subtitle={c.heroSubtitle}
    imageLabel="Enfants de Paradisakely"
    tone="sun"
    primaryCta={{ label: c.heroCta, href: '#enfants' }}
  />

  <section class="section bg-white">
    <div class="container-jfk max-w-3xl">
      <h2 class="text-3xl sm:text-4xl">{c.storyTitle}</h2>
      <div class="mt-6 space-y-4 text-lg leading-relaxed text-night/75">
        {c.storyParagraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="section bg-sky-50">
    <div class="container-jfk">
      <h2 class="text-center text-3xl sm:text-4xl">{c.coversTitle}</h2>
      <div class="mx-auto mt-10 grid max-w-4xl gap-x-10 gap-y-8 sm:grid-cols-2">
        {c.covers.map((item, i) => (
          <IconFeature icon={item.icon} title={item.title} text={item.text} tone={(['sky', 'leaf', 'sun'] as const)[i % 3]} />
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-jfk">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl sm:text-4xl">{c.tiersTitle}</h2>
        <p class="mt-3 text-night/70">{c.tiersSubtitle}</p>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {sponsorshipTiers.map((tier) => (
          <div class:list={['card flex flex-col gap-4 p-7', tier.highlighted && 'ring-2 ring-sun-500']}>
            {tier.highlighted && <span class="badge w-fit bg-sun-100 text-sun-700">{lang === 'fr' ? 'Le plus choisi' : 'Most popular'}</span>}
            <h3 class="font-display text-xl font-bold text-night">{tier.titleFr}</h3>
            <p class="font-display text-3xl font-extrabold text-sky-600">
              {tier.amount}&nbsp;{tier.currency === 'EUR' ? '€' : tier.currency}
              <span class="text-base font-medium text-night/70">{t.common.perMonth}</span>
            </p>
            <p class="flex-1 text-sm leading-relaxed text-night/70">{tier.descriptionFr}</p>
            <a href="#formulaire" class="btn-primary w-full">{t.common.sponsorNow}</a>
          </div>
        ))}
      </div>
      <p class="mx-auto mt-6 max-w-2xl text-center text-xs text-night/70">
        Montants indicatifs en euros, modifiables à tout moment par JFK (voir README).
      </p>
    </div>
  </section>

  <section id="enfants" class="section bg-leaf-50 scroll-mt-24">
    <div class="container-jfk">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl sm:text-4xl">{c.galleryTitle}</h2>
        <p class="mt-3 text-night/70">{c.gallerySubtitle}</p>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {children.map((child) => (
          <ProfileCard
            name={child.data.firstName}
            subtitle={lang === 'fr' ? `${child.data.age} ans` : `${child.data.age} years old`}
            description={child.data.bio.fr}
            tone={child.data.photoPlaceholder as 'sun' | 'sky' | 'leaf'}
            kind="child"
            statusLabel={child.data.status === 'available' ? t.common.available : t.common.sponsored}
            statusVariant={child.data.status}
            ctaLabel={child.data.status === 'available' ? t.common.sponsorNow : undefined}
            ctaHref={child.data.status === 'available' ? '#formulaire' : undefined}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-jfk max-w-3xl rounded-xl2 bg-sky-50 p-8 sm:p-10">
      <h2 class="text-2xl sm:text-3xl">{c.protectionTitle}</h2>
      <p class="mt-4 leading-relaxed text-night/75">{c.protectionText}</p>
      <a href={routeUrl('childProtection', lang)} class="btn-outline-dark mt-6 inline-flex">{c.protectionCta}</a>
    </div>
  </section>

  <section class="section bg-sun-50">
    <div class="container-jfk">
      <h2 class="text-center text-3xl sm:text-4xl">{c.journeyTitle}</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {c.journey.map((step) => (
          <div class="card p-6 text-center">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-sun-500 font-display text-xl font-extrabold text-night">
              {step.step}
            </div>
            <h3 class="mt-4 font-display font-bold text-night">{step.title}</h3>
            <p class="mt-2 text-sm text-night/70">{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-jfk max-w-3xl">
      <h2 class="text-center text-3xl sm:text-4xl">{c.faqTitle}</h2>
      <div class="mt-8 space-y-3">
        {c.faq.map((item) => (
          <details class="card group p-5">
            <summary class="cursor-pointer list-none font-display font-semibold text-night marker:content-none">
              <span class="flex items-center justify-between gap-4">
                {item.q}
                <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0 text-sky-600 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6" />
                </svg>
              </span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-night/70">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section id="formulaire" class="section bg-sky-50 scroll-mt-24">
    <div class="container-jfk max-w-2xl">
      <h2 class="text-center text-3xl sm:text-4xl">{c.formTitle}</h2>
      <p class="mt-3 text-center text-night/70">{c.formSubtitle}</p>
      <div class="card mt-8 p-6 sm:p-8">
        <WebForm lang={lang} subject={c.formSubject} formId="form-parrainage">
          <div class="grid gap-5 sm:grid-cols-2">
            <FormField label={t.form.name} name="name" type="text" />
            <FormField label={t.form.email} name="email" type="email" />
            <FormField label={t.form.country} name="country" type="text" />
            <FormField
              label={t.form.selectChild}
              name="enfant_choisi"
              type="select"
              options={[
                { value: '', label: t.form.choose },
                ...children.map((child) => ({ value: child.data.firstName, label: child.data.firstName })),
              ]}
            />
          </div>
          <div class="mt-5">
            <FormField
              label={t.form.selectFormula}
              name="formule"
              type="select"
              options={[
                { value: '', label: t.form.choose },
                ...sponsorshipTiers.map((tier) => ({ value: tier.titleFr, label: `${tier.titleFr} — ${tier.amount}€/mois` })),
              ]}
            />
          </div>
          <div class="mt-5">
            <FormField label={t.form.message} name="message" type="textarea" required={false} />
          </div>
        </WebForm>
      </div>
    </div>
  </section>

  <section class="section bg-night text-white">
    <div class="container-jfk text-center">
      <h2 class="text-3xl text-white sm:text-4xl">{c.ctaFinalTitle}</h2>
      <a href="#formulaire" class="btn-primary mt-6 inline-flex">{c.ctaFinalCta}</a>
    </div>
  </section>
</BaseLayout>
