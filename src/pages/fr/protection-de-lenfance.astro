---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { childProtectionContent } from '../../data/pages/legal';

const lang = 'fr' as const;
const c = childProtectionContent[lang];
---

<BaseLayout lang={lang} currentRoute="childProtection" title={c.seoTitle} description={c.seoDescription}>
  <section class="section bg-sky-50">
    <div class="container-jfk max-w-3xl text-center">
      <h1 class="text-4xl sm:text-5xl">{c.heroTitle}</h1>
      <p class="mt-4 text-lg text-night/70">{c.heroSubtitle}</p>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-jfk max-w-3xl">
      <p class="text-lg leading-relaxed text-night/75">{c.intro}</p>

      <div class="mt-10 space-y-8">
        {c.sections.map((section) => (
          <div>
            <h2 class="text-xl font-bold text-night sm:text-2xl">{section.title}</h2>
            <ul class="mt-3 list-disc space-y-2 pl-5 text-night/75">
              {section.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
