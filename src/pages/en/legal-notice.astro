---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { legalContent } from '../../data/pages/legal';

const lang = 'en' as const;
const c = legalContent[lang];
---

<BaseLayout lang={lang} currentRoute="legal" title={c.seoTitle} description={c.seoDescription}>
  <section class="section bg-white">
    <div class="container-jfk max-w-3xl">
      <h1 class="text-4xl sm:text-5xl">{c.heroTitle}</h1>
      <div class="mt-10 space-y-8">
        {c.sections.map((section) => (
          <div>
            <h2 class="text-xl font-bold text-night sm:text-2xl">{section.title}</h2>
            <p class="mt-3 leading-relaxed text-night/75">{section.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
