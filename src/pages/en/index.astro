---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import PillarCard from '../../components/PillarCard.astro';
import ImpactCounters from '../../components/ImpactCounters.astro';
import Testimonial from '../../components/Testimonial.astro';
import ProgressBar from '../../components/ProgressBar.astro';
import { homeContent } from '../../data/pages/home';
import { routeUrl } from '../../i18n/routes';
import { getCollection } from 'astro:content';

const lang = 'en' as const;
const c = homeContent[lang];

const testimonials = (await getCollection('testimonials')).sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('projects2026')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout lang={lang} currentRoute="home" title={c.seoTitle} description={c.seoDescription}>
  <Hero
    eyebrow={c.heroEyebrow}
    title={c.heroTitle}
    subtitle={c.heroSubtitle}
    imageLabel="Hero Home JFK"
    tone="sun"
    size="full"
    primaryCta={{ label: c.heroPrimaryCta, href: routeUrl('sponsorChild', lang) }}
    secondaryCta={{ label: c.heroSecondaryCta, href: routeUrl('donate', lang) }}
  />

  {/* ---- Vision: asymmetric editorial composition ---- */}
  <section class="section bg-paper">
    <div class="container-jfk grid gap-y-8 lg:grid-cols-12 lg:gap-x-16">
      <div class="lg:col-span-5">
        <h2>{c.visionTitle}</h2>
        <p class="mt-5 font-display text-2xl leading-snug text-ink-600 sm:text-3xl">
          {c.visionParagraphs[0]}
        </p>
      </div>
      <div class="space-y-5 text-lg leading-relaxed text-ink-600 lg:col-span-6 lg:col-start-7">
        {c.visionParagraphs.slice(1).map((p) => <p class="prose-measure">{p}</p>)}
        <p class="font-display text-lg italic text-clay-600">“Acts 1:8”</p>
      </div>
    </div>
  </section>

  {/* ---- Pillars ---- */}
  <section class="section bg-paper-200">
    <div class="container-jfk">
      <div class="max-w-2xl">
        <h2>{c.pillarsTitle}</h2>
        <p class="mt-4 text-lg text-ink-600">{c.pillarsSubtitle}</p>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {c.pillars.map((pillar, i) => (
          <PillarCard
            icon={pillar.icon}
            tone={pillar.tone}
            title={pillar.title}
            description={pillar.description}
            featured={i === 0}
          />
        ))}
      </div>
    </div>
  </section>

  {/* ---- Impact: dark earth band, gold figures ---- */}
  <section class="section bg-ink-800">
    <div class="container-jfk">
      <div class="mb-12 max-w-2xl">
        <h2 class="text-paper-50">{c.statsTitle}</h2>
        <p class="mt-4 text-lg text-paper-100/80">{c.statsSubtitle}</p>
      </div>
      <ImpactCounters lang={lang} onDark />
    </div>
  </section>

  {/* ---- Testimonials ---- */}
  <section class="section bg-paper">
    <div class="container-jfk">
      <div class="mb-12 max-w-2xl">
        <h2>{c.testimonialsTitle}</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {testimonials.map((item) => (
          <Testimonial
            name={item.data.name}
            role={item.data.role.en}
            quote={item.data.quote.en}
            tone={item.data.photoPlaceholder as 'sun' | 'sky' | 'leaf'}
          />
        ))}
      </div>
    </div>
  </section>

  {/* ---- 2026 projects: two columns ---- */}
  <section class="section bg-paper-200">
    <div class="container-jfk grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-16">
      <div class="lg:col-span-5">
        <h2>{c.projectsBannerTitle}</h2>
        <p class="mt-5 max-w-md text-lg leading-relaxed text-ink-600">{c.projectsBannerText}</p>
        <a href={routeUrl('projects2026', lang)} class="btn-primary mt-8">
          {c.projectsBannerCta}
          <svg viewBox="0 0 20 20" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 10h11m0 0l-4-4m4 4l-4 4" />
          </svg>
        </a>
      </div>
      <div class="card space-y-7 p-8 sm:p-10 lg:col-span-6 lg:col-start-7">
        {projects.map((project) => (
          <div>
            <p class="mb-2.5 font-display text-lg text-ink-800">{project.data.title.en}</p>
            <ProgressBar
              goal={project.data.budgetGoal}
              raised={project.data.budgetRaised}
              currency={project.data.currency}
              goalLabel="Goal"
              raisedLabel="Raised"
              tone={project.data.photoPlaceholder as 'sun' | 'sky' | 'leaf'}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ---- Final call: terracotta band ---- */}
  <section class="relative overflow-hidden bg-clay-600 py-24 text-paper-50 sm:py-28">
    <div class="absolute inset-0 opacity-[0.12]" aria-hidden="true"
      style="background-image: radial-gradient(circle at 20% 20%, #fff 0, transparent 40%), radial-gradient(circle at 85% 75%, #fff 0, transparent 35%);">
    </div>
    <div class="container-jfk relative text-center">
      <h2 class="mx-auto max-w-3xl text-paper-50">{c.finalCtaTitle}</h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-paper-100/90">{c.finalCtaText}</p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href={routeUrl('sponsorChild', lang)} class="btn-invert">{c.finalCtaPrimary}</a>
        <a href={routeUrl('donate', lang)} class="btn-outline">{c.finalCtaSecondary}</a>
      </div>
    </div>
  </section>
</BaseLayout>
