---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import PillarCard from '../../components/PillarCard.astro';
import Timeline from '../../components/Timeline.astro';
import PlaceholderImage from '../../components/PlaceholderImage.astro';
import { missionContent, missionTimelineEn } from '../../data/pages/mission';
import { annualReportUrl } from '../../data/site';

const lang = 'en' as const;
const c = missionContent[lang];
---

<BaseLayout lang={lang} currentRoute="mission" title={c.seoTitle} description={c.seoDescription}>
  <Hero eyebrow={c.heroEyebrow} title={c.heroTitle} subtitle={c.heroSubtitle} imageLabel="JFK team on mission" tone="sky" />

  <section class="section bg-white">
    <div class="container-jfk max-w-3xl">
      <h2 class="text-3xl sm:text-4xl">{c.storyTitle}</h2>
      <p class="mt-6 text-lg leading-relaxed text-night/75">{c.storyText}</p>
    </div>
  </section>

  <section class="section bg-sky-50">
    <div class="container-jfk grid max-w-5xl gap-10 lg:grid-cols-[280px,1fr] lg:items-center">
      <PlaceholderImage tone="sun" label={c.presidentName} kind="general" class="mx-auto aspect-square w-48 rounded-full lg:w-full" />
      <div>
        <h2 class="text-2xl sm:text-3xl">{c.presidentTitle}</h2>
        <blockquote class="mt-4 font-display text-xl font-semibold leading-snug text-night">"{c.presidentQuote}"</blockquote>
        <p class="mt-4 font-semibold text-night">{c.presidentName}</p>
        <p class="text-sm text-night/70">{c.presidentRole}</p>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-jfk max-w-3xl text-center">
      <h2 class="text-3xl sm:text-4xl">{c.visionTitle}</h2>
      <p class="mt-6 text-lg leading-relaxed text-night/75">{c.visionText}</p>
    </div>
  </section>

  <section class="section bg-leaf-50">
    <div class="container-jfk">
      <h2 class="text-center text-3xl sm:text-4xl">{c.pillarsTitle}</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {c.pillars.map((pillar) => (
          <PillarCard icon={pillar.icon} tone={pillar.tone} title={pillar.title} description={pillar.text} />
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-jfk max-w-3xl">
      <h2 class="text-3xl sm:text-4xl">{c.strategyTitle}</h2>
      <div class="mt-8 grid gap-8 sm:grid-cols-2">
        <div class="card p-6">
          <h3 class="font-display text-lg font-bold text-sky-700">{c.strategyLevel1Title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-night/70">{c.strategyLevel1Text}</p>
        </div>
        <div class="card p-6">
          <h3 class="font-display text-lg font-bold text-leaf-700">{c.strategyLevel2Title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-night/70">{c.strategyLevel2Text}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-sun-50">
    <div class="container-jfk max-w-3xl">
      <h2 class="text-3xl sm:text-4xl">{c.hubTitle}</h2>
      <p class="mt-6 text-lg leading-relaxed text-night/75">{c.hubText}</p>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-jfk max-w-3xl">
      <h2 class="mb-10 text-center text-3xl sm:text-4xl">Our journey</h2>
      <Timeline items={missionTimelineEn} />
    </div>
  </section>

  <section class="section bg-night text-white">
    <div class="container-jfk max-w-2xl text-center">
      <h2 class="text-3xl text-white sm:text-4xl">{c.reportTitle}</h2>
      <p class="mt-4 text-white/80">{c.reportText}</p>
      <a href={annualReportUrl} target="_blank" rel="noopener noreferrer" class="btn-primary mt-6 inline-flex">
        {c.reportCta}
      </a>
    </div>
  </section>
</BaseLayout>
