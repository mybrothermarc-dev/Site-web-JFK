---
import { getCollection } from 'astro:content';
import { routeUrl, otherLang, type RouteKey, type Lang } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
  currentRoute: RouteKey;
  /** Adresse exacte de cette page dans l'autre langue, quand elle diffère de la carte des pages */
  otherLangHref?: string;
}
const { lang, currentRoute, otherLangHref } = Astro.props;
const t = useTranslations(lang);

// L'onglet Blog n'apparaît que s'il existe au moins un article publié dans cette langue
const frenchBodies = lang === 'fr' ? new Set((await getCollection('blogFr')).map((entry) => entry.id)) : null;
const publishedPosts = await getCollection(
  'blog',
  ({ id, data }) => data.published && (!frenchBodies || (Boolean(data.titleFr) && frenchBodies.has(id)))
);
const showBlog = publishedPosts.length > 0 || currentRoute === 'blog';

const navItems: { key: RouteKey; label: string }[] = [
  { key: 'home', label: t.nav.home },
  { key: 'mission', label: t.nav.mission },
  { key: 'sponsorChild', label: t.nav.sponsorChild },
  { key: 'supportMissionaries', label: t.nav.supportMissionaries },
  { key: 'supportTeachers', label: t.nav.supportTeachers },
  { key: 'projects2026', label: t.nav.projects2026 },
  ...(showBlog ? [{ key: 'blog' as const, label: t.nav.blog }] : []),
  { key: 'contact', label: t.nav.contact },
];

const otherLangCode = otherLang(lang);
const otherLangUrl = otherLangHref ?? routeUrl(currentRoute, otherLangCode);
---

<header
  id="site-header"
  class="sticky top-0 z-[var(--z-header)] border-b border-ink-800/[0.08] bg-paper/85 backdrop-blur-md transition-shadow duration-300"
>
  <div class="container-jfk flex h-[4.75rem] items-center justify-between gap-4">
    <a href={routeUrl('home', lang)} class="flex shrink-0 items-center gap-3" aria-label="Jesus Family Kingdom — accueil">
      <img src="/images/logo-full.png" alt="Jesus Family Kingdom" class="h-10 w-auto" width="600" height="336" />
    </a>

    <nav aria-label={lang === 'fr' ? 'Navigation principale' : 'Main navigation'} class="hidden items-center gap-6 xl:flex">
      {navItems.map((item) => (
        <a
          href={routeUrl(item.key, lang)}
          aria-current={currentRoute === item.key ? 'page' : undefined}
          class:list={[
            'nav-link relative py-2 text-[0.92rem] font-semibold text-ink-700 transition-colors hover:text-clay-600',
            currentRoute === item.key && 'is-active text-clay-700',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-4 lg:flex">
      <a
        href={otherLangUrl}
        class="text-sm font-semibold text-ink-500 transition-colors hover:text-clay-600"
        aria-label={lang === 'fr' ? 'Switch to English' : 'Passer en français'}
      >
        {lang === 'fr' ? 'EN' : 'FR'}
      </a>
      <span class="h-4 w-px bg-ink-800/15" aria-hidden="true"></span>
      <a href={routeUrl('donate', lang)} class="btn-primary !px-5 !py-2.5">
        {t.nav.donate}
      </a>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="flex items-center justify-center rounded-lg p-2 text-ink-800 xl:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label={lang === 'fr' ? 'Ouvrir le menu' : 'Open menu'}
    >
      <svg id="icon-open" viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.75">
        <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <svg id="icon-close" viewBox="0 0 24 24" class="hidden h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.75">
        <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>

  <nav
    id="mobile-menu"
    class="hidden flex-col gap-1 border-t border-ink-800/10 bg-paper-50 px-5 py-5 xl:hidden"
    aria-label={lang === 'fr' ? 'Navigation mobile' : 'Mobile navigation'}
  >
    {navItems.map((item) => (
      <a
        href={routeUrl(item.key, lang)}
        aria-current={currentRoute === item.key ? 'page' : undefined}
        class:list={[
          'rounded-lg px-3 py-3 text-base font-semibold',
          currentRoute === item.key ? 'bg-clay-50 text-clay-700' : 'text-ink-700',
        ]}
      >
        {item.label}
      </a>
    ))}
    <div class="mt-3 flex items-center gap-3 border-t border-ink-800/10 pt-4">
      <a href={otherLangUrl} class="rounded-lg border border-ink-800/15 px-3 py-2 text-sm font-semibold text-ink-600">
        {lang === 'fr' ? 'EN' : 'FR'}
      </a>
      <a href={routeUrl('donate', lang)} class="btn-primary flex-1">
        {t.nav.donate}
      </a>
    </div>
  </nav>
</header>

<style>
  /* Soulignement animé façon éditorial */
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0.25rem;
    height: 2px;
    width: 100%;
    transform: scaleX(0);
    transform-origin: left;
    background-color: #F4A623;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .nav-link:hover::after,
  .nav-link.is-active::after {
    transform: scaleX(1);
  }
  /* Ombre douce qui apparaît au défilement pour détacher le header du contenu */
  #site-header.scrolled {
    box-shadow: 0 8px 24px -18px rgba(18, 47, 58, 0.6);
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const onScroll = () => {
    if (window.scrollY > 24) header?.classList.add('scrolled');
    else header?.classList.remove('scrolled');
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('hidden');
    menu?.classList.toggle('flex');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    header?.classList.add('scrolled');
  });
</script>
