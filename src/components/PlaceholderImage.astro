---
/**
 * Image de remplacement clairement identifiée, en attendant les vraies photos.
 * À remplacer : dépose les photos réelles dans /public/images/ et utilise <img>
 * à la place de ce composant (voir README > "Modifier les photos").
 */
interface Props {
  tone?: 'sun' | 'sky' | 'leaf';
  label: string; // nom de la personne ou du projet, pour l'attribut alt
  kind?: 'child' | 'missionary' | 'teacher' | 'project' | 'general';
  class?: string;
}

const { tone = 'sky', label, kind = 'general', class: className = '' } = Astro.props;

const gradients: Record<string, string> = {
  sun: 'from-sun-200 via-sun-300 to-sun-500',
  sky: 'from-sky-200 via-sky-300 to-sky-500',
  leaf: 'from-leaf-200 via-leaf-300 to-leaf-500',
};

const icons: Record<string, string> = {
  child: 'M12 12a4 4 0 100-8 4 4 0 000 8zm0 2c-4.4 0-8 2.2-8 5v1h16v-1c0-2.8-3.6-5-8-5z',
  missionary: 'M12 2l2.2 4.5L19 7.3l-3.5 3.4.8 4.8L12 13.3 7.7 15.5l.8-4.8L5 7.3l4.8-.8L12 2z',
  teacher: 'M12 3L1 8l11 5 9-4.1V17h2V8L12 3zM5 10.8V14c0 2.2 3.1 4 7 4s7-1.8 7-4v-3.2l-7 3.2-7-3.2z',
  project: 'M4 21V9l8-6 8 6v12h-6v-7H10v7H4z',
  general: 'M12 12a4 4 0 100-8 4 4 0 000 8zm0 2c-4.4 0-8 2.2-8 5v1h16v-1c0-2.8-3.6-5-8-5z',
};
---

<div
  role="img"
  aria-label={`Photo de ${label} — à remplacer par une photo réelle`}
  class:list={[
    'relative flex items-center justify-center overflow-hidden bg-gradient-to-br',
    gradients[tone],
    className,
  ]}
>
  <svg viewBox="0 0 24 24" fill="currentColor" class="h-1/3 w-1/3 text-white/70">
    <path d={icons[kind]}></path>
  </svg>
  <span class="absolute bottom-2 right-2 rounded-md bg-night/60 px-2 py-0.5 font-body text-[10px] font-medium uppercase tracking-wide text-white">
    Photo à venir
  </span>
</div>
