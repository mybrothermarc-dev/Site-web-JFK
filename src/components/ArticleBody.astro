---
/** Mise en forme du texte d'un article de blog écrit dans l'admin. */
---

<div class="article-body mx-auto max-w-prose">
  <slot />
</div>

<style is:global>
  .article-body {
    font-size: 1.125rem;
    line-height: 1.75;
    color: #2c424e;
  }
  .article-body > * + * {
    margin-top: 1.25em;
  }
  .article-body h2 {
    margin-top: 2em;
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    line-height: 1.2;
    color: #122f3a;
  }
  .article-body h3 {
    margin-top: 1.75em;
    font-size: 1.35rem;
    line-height: 1.3;
    color: #122f3a;
  }
  .article-body h2 + *,
  .article-body h3 + * {
    margin-top: 0.6em;
  }
  .article-body strong {
    color: #122f3a;
  }
  .article-body a {
    color: #12749f;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .article-body a:hover {
    color: #0e5c7e;
  }
  .article-body ul,
  .article-body ol {
    padding-left: 1.4em;
  }
  .article-body ul {
    list-style: disc;
  }
  .article-body ol {
    list-style: decimal;
  }
  .article-body li + li {
    margin-top: 0.4em;
  }
  .article-body li::marker {
    color: #12749f;
  }
  .article-body img {
    width: 100%;
    height: auto;
    border-radius: 1rem;
  }
  .article-body blockquote {
    padding: 0 1.25rem;
    font-family: 'Petrona', Georgia, serif;
    font-size: 1.4rem;
    font-style: italic;
    line-height: 1.45;
    color: #122f3a;
  }
  .article-body hr {
    height: 1px;
    margin: 2.5em 0;
    border: 0;
    background: rgba(18, 47, 58, 0.12);
  }
</style>
