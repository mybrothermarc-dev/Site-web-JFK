---
interface Props {
  icon: 'home' | 'meal' | 'school' | 'supplies' | 'medical' | 'heart' | 'travel' | 'book' | 'salary' | 'training' | 'building';
  title: string;
  text: string;
  tone?: 'sun' | 'sky' | 'leaf';
