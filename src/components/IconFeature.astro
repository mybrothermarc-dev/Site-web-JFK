  building: 'M4 21V9l8-6 8 6v12h-6v-7H10v7H4z',
};

const bgTone: Record<string, string> = {
  sun: 'bg-sun-100 text-sun-700',
  sky: 'bg-sky-100 text-sky-700',
  leaf: 'bg-leaf-100 text-leaf-700',
};
---

<div class="flex gap-4">
  <div class:list={['flex h-11 w-11 shrink-0 items-center justify-center rounded-full', bgTone[tone]]}>
    <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor"><path d={icons[icon]}></path></svg>
  </div>
  <div>
    <h3 class="font-display font-bold text-night">{title}</h3>
    <p class="mt-1 text-sm leading-relaxed text-night/70">{text}</p>
  </div>
</div>
