  medical: 'M12 2a4 4 0 014 4v2h2a4 4 0 014 4 4 4 0 01-4 4h-2v2a4 4 0 01-4 4 4 4 0 01-4-4v-2H6a4 4 0 01-4-4 4 4 0 014-4h2V6a4 4 0 014-4z',
  heart: 'M12 21s-7.5-4.6-10-9.3C.5 8.4 2.3 5 5.7 5c2 0 3.4 1 4.3 2.4C11 6 12.4 5 14.3 5 17.7 5 19.5 8.4 22 11.7 19.5 16.4 12 21 12 21z',
  travel: 'M21 16v-2l-8-5V3.5a1.5 1.5 0 00-3 0V9l-8 5v2l8-2.5V19l-2.5 1.5V22l4.5-1 4.5 1v-1.5L13 19v-5.5l8 2.5z',
  book: 'M4 4h9a3 3 0 013 3v13a2.5 2.5 0 00-2.5-2.5H4V4zm16 0h-2v14.5A2.5 2.5 0 0120.5 21H20V4z',
  salary: 'M12 2a10 10 0 100 20 10 10 0 000-20zm.9 15.5v1.3h-1.6v-1.3c-1.7-.3-2.7-1.4-2.8-2.9h1.7c.1.8.6 1.4 1.7 1.4.9 0 1.6-.4 1.6-1.2 0-.7-.5-1-1.8-1.4-1.7-.5-2.9-1.1-2.9-2.7 0-1.3 1-2.2 2.5-2.5V5.5h1.6v1.3c1.5.3 2.4 1.3 2.5 2.6h-1.7c-.1-.7-.6-1.2-1.5-1.2-.9 0-1.4.4-1.4 1.1 0 .6.5.9 1.8 1.3 1.9.5 2.9 1.2 2.9 2.8 0 1.4-1.1 2.3-2.6 2.6z',
