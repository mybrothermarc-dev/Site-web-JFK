---
/**
 * « Comment donner » : le donateur écrit sur WhatsApp ou par e-mail, avec un message déjà rédigé,
 * et JFK lui envoie ses coordonnées en privé. Rien de bancaire n'est publié sur le site.
 */
import { siteConfig } from '../data/site';

interface Props {
  title: string;
  body: string;
  whatsappLabel: string;
  emailLabel: string;
  subject: string;
  message: string;
  note: string;
}

const { title, body, whatsappLabel, emailLabel, subject, message, note } = Astro.props;

const whatsappHref = `${siteConfig.contacts.whatsappLink}?text=${encodeURIComponent(message)}`;
const emailHref = `mailto:${siteConfig.contacts.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(message)}`;
---

<section class="section bg-white">
  <div class="container-jfk max-w-2xl text-center">
    <h2 class="text-3xl sm:text-4xl">{title}</h2>
    <p class="mx-auto mt-5 max-w-prose text-lg leading-relaxed text-night/75">{body}</p>
    <div class="mt-9 flex flex-wrap justify-center gap-4">
      <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn-primary">
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
          <path d="M12.04 2c-5.5 0-9.96 4.46-9.96 9.96 0 1.76.46 3.48 1.34 5L2 22l5.2-1.36a9.9 9.9 0 004.84 1.24h.01c5.5 0 9.96-4.46 9.96-9.96 0-2.66-1.04-5.16-2.92-7.04A9.88 9.88 0 0012.04 2zm5.8 14.08c-.24.68-1.4 1.3-1.94 1.34-.5.04-.96.22-3.24-.68-2.74-1.08-4.46-3.88-4.6-4.06-.14-.18-1.1-1.46-1.1-2.78 0-1.32.7-1.98.94-2.24.24-.26.52-.32.7-.32h.5c.16 0 .38-.06.6.46.22.54.76 1.86.82 2 .06.14.1.3.02.48-.34.7-.7.68-.5 1.02.74 1.28 1.48 1.72 2.6 2.28.2.1.32.08.44-.04.12-.14.5-.58.64-.78.14-.2.28-.16.46-.1.18.06 1.16.56 1.36.66.2.1.34.14.38.22.06.1.06.5-.18 1.18z" />
        </svg>
        {whatsappLabel}
      </a>
      <a href={emailHref} class="btn-outline-dark">{emailLabel}</a>
    </div>
    <p class="mt-6 text-sm text-night/70">{note}</p>
  </div>
</section>
