---
interface Props {
  goal: number;
  raised: number;
  currency: string;
  goalLabel: string;
  raisedLabel: string;
  tone?: 'sun' | 'sky' | 'leaf';
  /** Sur fond sombre */
  onDark?: boolean;
}
const { goal, raised, currency, goalLabel, raisedLabel, tone = 'sun', onDark = false } = Astro.props;
const percent = Math.min(100, Math.round((raised / goal) * 100));

const barTone: Record<string, string> = {
  sun: 'bg-clay-500',
  sky: 'bg-lake-400',
  leaf: 'bg-moss-400',
};

function formatAmount(n: number, curr: string) {
  return new Intl.NumberFormat('fr-FR').format(n) + ' ' + curr;
}
---

<div>
  <div class="mb-2.5 flex items-end justify-between gap-4 text-sm">
    <span class:list={['font-semibold', onDark ? 'text-paper-50' : 'text-ink-800']}>
      {raisedLabel} : {formatAmount(raised, currency)}
    </span>
    <span class:list={onDark ? 'text-paper-100/60' : 'text-ink-500'}>
      {goalLabel} : {formatAmount(goal, currency)}
    </span>
  </div>
  <div
    class:list={['h-2.5 w-full overflow-hidden rounded-full', onDark ? 'bg-paper-100/15' : 'bg-ink-800/10']}
    role="progressbar"
    aria-valuenow={percent}
    aria-valuemin={0}
    aria-valuemax={100}
  >
    <div class:list={['h-full rounded-full transition-[width] duration-700 ease-out-expo', barTone[tone]]} style={`width: ${percent}%`}></div>
  </div>
  <p class:list={['mt-1.5 text-right text-xs font-bold', onDark ? 'text-gold-300' : 'text-clay-600']}>{percent}%</p>
</div>
