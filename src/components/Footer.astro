---
import { routeUrl, type Lang } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';
import { siteConfig } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="relative bg-ink-800 text-paper-100">
  <div class="h-1 w-full bg-gradient-to-r from-clay-500 via-gold-500 to-moss-500" aria-hidden="true"></div>

  <div class="container-jfk grid gap-12 py-16 sm:grid-cols-2 lg:grid-cols-4 lg:gap-10">
    <div class="space-y-5 sm:col-span-2 lg:col-span-1">
      <img src="/images/logo-full-transparent.png" alt={siteConfig.name} class="h-14 w-auto" width="600" height="336" />
      <p class="max-w-xs text-sm leading-relaxed text-paper-100/75">{t.footer.tagline}</p>
      <p class="max-w-xs font-display text-[0.95rem] italic leading-relaxed text-gold-300">{t.footer.verse}</p>
    </div>

    <div>
      <h2 class="mb-5 text-xs font-bold uppercase tracking-[0.14em] text-gold-400">{t.footer.quickLinks}</h2>
      <ul class="space-y-3 text-sm text-paper-100/80">
        <li><a class="transition-colors hover:text-gold-300" href={routeUrl('mission', lang)}>{t.nav.mission}</a></li>
        <li><a class="transition-colors hover:text-gold-300" href={routeUrl('sponsorChild', lang)}>{t.nav.sponsorChild}</a></li>
        <li><a class="transition-colors hover:text-gold-300" href={routeUrl('supportMissionaries', lang)}>{t.nav.supportMissionaries}</a></li>
        <li><a class="transition-colors hover:text-gold-300" href={routeUrl('supportTeachers', lang)}>{t.nav.supportTeachers}</a></li>
        <li><a class="transition-colors hover:text-gold-300" href={routeUrl('projects2026', lang)}>{t.nav.projects2026}</a></li>
        <li><a class="transition-colors hover:text-gold-300" href={routeUrl('donate', lang)}>{t.nav.donate}</a></li>
      </ul>
    </div>

    <div>
      <h2 class="mb-5 text-xs font-bold uppercase tracking-[0.14em] text-gold-400">{t.footer.contactUs}</h2>
      <ul class="space-y-3 text-sm text-paper-100/80">
        <li class="leading-relaxed">{siteConfig.address}</li>
        <li><a class="transition-colors hover:text-gold-300" href={`tel:${siteConfig.contacts.mobile.replace(/\s/g, '')}`}>{siteConfig.contacts.mobile}</a></li>
        <li><a class="transition-colors hover:text-gold-300" href={siteConfig.contacts.whatsappLink} target="_blank" rel="noopener noreferrer">WhatsApp {siteConfig.contacts.whatsapp}</a></li>
        <li><a class="transition-colors hover:text-gold-300" href={`mailto:${siteConfig.contacts.email}`}>{siteConfig.contacts.email}</a></li>
      </ul>
    </div>

    <div>
      <h2 class="mb-5 text-xs font-bold uppercase tracking-[0.14em] text-gold-400">{t.footer.followUs}</h2>
      <div class="flex gap-3">
        <a
          href={siteConfig.socials.facebook}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
          class="flex h-11 w-11 items-center justify-center rounded-full border border-paper-100/15 bg-paper-100/[0.06] text-paper-100/80 transition-colors hover:border-gold-400 hover:bg-gold-500 hover:text-ink-800"
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor"><path d="M22 12a10 10 0 10-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.2c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0022 12z"/></svg>
        </a>
        <a
          href={siteConfig.socials.instagram}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="flex h-11 w-11 items-center justify-center rounded-full border border-paper-100/15 bg-paper-100/[0.06] text-paper-100/80 transition-colors hover:border-gold-400 hover:bg-gold-500 hover:text-ink-800"
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor"><path d="M12 2.2c3.2 0 3.6 0 4.9.07 3.3.15 4.8 1.7 5 5C22 8.5 22 8.9 22 12s0 3.5-.07 4.8c-.15 3.3-1.7 4.8-5 5-1.3.06-1.7.07-4.9.07s-3.6 0-4.9-.07c-3.3-.15-4.8-1.7-5-5C2 15.5 2 15.1 2 12s0-3.5.07-4.8c.15-3.3 1.7-4.8 5-5C8.4 2.2 8.8 2.2 12 2.2zm0 1.8c-3.15 0-3.5 0-4.75.07-2.4.1-3.53 1.25-3.63 3.63C3.5 8.5 3.5 8.85 3.5 12s0 3.5.07 4.75c.1 2.38 1.22 3.53 3.63 3.63C8.5 20.5 8.85 20.5 12 20.5s3.5 0 4.75-.07c2.4-.1 3.53-1.24 3.63-3.63.07-1.25.07-1.6.07-4.75s0-3.5-.07-4.75c-.1-2.38-1.24-3.53-3.63-3.63C15.5 3.5 15.15 3.5 12 3.5zm0 3.5a5 5 0 110 10 5 5 0 010-10zm0 1.8a3.2 3.2 0 100 6.4 3.2 3.2 0 000-6.4zm5.15-2.1a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z"/></svg>
        </a>
      </div>
    </div>
  </div>

  <div class="border-t border-paper-100/10">
    <div class="container-jfk flex flex-col items-center gap-3 py-7 text-xs text-paper-100/55 sm:flex-row sm:justify-between">
      <p>&copy; {year} {siteConfig.name}. {t.footer.rights}</p>
      <div class="flex gap-6">
        <a class="transition-colors hover:text-gold-300" href={routeUrl('childProtection', lang)}>{t.footer.childProtection}</a>
        <a class="transition-colors hover:text-gold-300" href={routeUrl('legal', lang)}>{t.footer.legal}</a>
      </div>
    </div>
  </div>
</footer>
