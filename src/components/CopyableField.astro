---
import type { Lang } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

interface Props {
  label: string;
  value: string;
  lang: Lang;
}
const { label, value, lang } = Astro.props;
const t = useTranslations(lang);
const fieldId = `copy-${label.replace(/\s+/g, '-').toLowerCase()}`;
---

<div class="flex flex-col gap-1 rounded-lg border border-night/10 bg-white p-3 sm:flex-row sm:items-center sm:justify-between">
  <div>
    <p class="text-xs font-semibold uppercase tracking-wide text-night/50">{label}</p>
    <p id={fieldId} class="font-mono text-sm text-night">{value}</p>
  </div>
  <button
    type="button"
    class="copy-btn mt-2 inline-flex items-center justify-center gap-1.5 self-start rounded-full border border-night/15 px-3 py-1.5 text-xs font-semibold text-night/80 hover:border-sky-500 hover:text-sky-700 sm:mt-0"
    data-copy-target={fieldId}
    aria-label={`${t.common.copy} ${label}`}
  >
    <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="9" y="9" width="12" height="12" rx="2"></rect>
      <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path>
    </svg>
    <span class="copy-label">{t.common.copy}</span>
  </button>
</div>

<script define:vars={{ copiedLabel: t.common.copied, copyLabel: t.common.copy }}>
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const targetId = btn.getAttribute('data-copy-target');
      const el = targetId ? document.getElementById(targetId) : null;
      const text = el?.textContent?.trim() ?? '';
      try {
        await navigator.clipboard.writeText(text);
        const labelSpan = btn.querySelector('.copy-label');
        if (labelSpan) {
          labelSpan.textContent = copiedLabel;
          setTimeout(() => (labelSpan.textContent = copyLabel), 2000);
        }
      } catch (e) {
        // Presse-papier indisponible (navigateur trop ancien) : on ignore silencieusement
      }
    });
  });
</script>
