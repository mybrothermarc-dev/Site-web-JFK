---
interface Props {
  icon: 'cross' | 'medical' | 'school' | 'home' | 'business';
  tone?: 'sun' | 'sky' | 'leaf';
  title: string;
  description: string;
}
const { icon, tone = 'sky', title, description } = Astro.props;

const icons: Record<string, string> = {
  cross: 'M11 2h2v8h8v2h-8v10h-2V12H3v-2h8V2z',
  medical: 'M12 2a4 4 0 014 4v2h2a4 4 0 014 4 4 4 0 01-4 4h-2v2a4 4 0 01-4 4 4 4 0 01-4-4v-2H6a4 4 0 01-4-4 4 4 0 014-4h2V6a4 4 0 014-4z',
  school: 'M12 3L1 8l11 5 9-4.1V17h2V8L12 3zM5 10.8V14c0 2.2 3.1 4 7 4s7-1.8 7-4v-3.2l-7 3.2-7-3.2z',
  home: 'M12 3l9 8h-3v9h-5v-6H11v6H6v-9H3l9-8z',
  business: 'M4 21V9l8-6 8 6v12h-6v-7H10v7H4z',
};

const bgTone: Record<string, string> = {
  sun: 'bg-sun-100 text-sun-700',
  sky: 'bg-sky-100 text-sky-700',
  leaf: 'bg-leaf-100 text-leaf-700',
};
---

<div class="card flex h-full flex-col gap-4 p-6 sm:p-7">
  <div class:list={['flex h-12 w-12 items-center justify-center rounded-full', bgTone[tone]]}>
    <svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor"><path d={icons[icon]}></path></svg>
  </div>
  <h3 class="font-display text-lg font-bold text-night">{title}</h3>
  <p class="text-sm leading-relaxed text-night/70">{description}</p>
</div>
