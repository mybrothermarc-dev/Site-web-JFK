---
interface Props {
  icon: 'cross' | 'medical' | 'school' | 'home' | 'business';
  tone?: 'sun' | 'sky' | 'leaf';
  title: string;
  description: string;
  /** Met la carte en avant (格 plus grande, sur 2 colonnes) */
  featured?: boolean;
}
const { icon, tone = 'sun', title, description, featured = false } = Astro.props;

// Icônes en trait (line) plutôt que pleines : plus soignées
const icons: Record<string, string> = {
  cross: 'M12 3v18M5 9h14',
  medical: 'M12 3a3 3 0 013 3v3h3a3 3 0 010 6h-3v3a3 3 0 01-6 0v-3H6a3 3 0 010-6h3V6a3 3 0 013-3z',
  school: 'M3 8l9-4 9 4-9 4-9-4zm3 4v4c0 1.5 2.7 3 6 3s6-1.5 6-3v-4',
  home: 'M4 11l8-7 8 7M6 10v9h5v-5h2v5h5v-9',
  business: 'M4 20V8l6-4 6 4v12M4 20h16M9 20v-4h6v4',
};

const toneClasses: Record<string, string> = {
  sun: 'bg-clay-100 text-clay-700',
  sky: 'bg-lake-100 text-lake-700',
  leaf: 'bg-moss-100 text-moss-700',
};
---

<div class:list={['card card-hover flex h-full flex-col gap-5 p-7 sm:p-8', featured && 'sm:col-span-2']}>
  <div class:list={['flex h-14 w-14 items-center justify-center rounded-2xl', toneClasses[tone]]}>
    <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d={icons[icon]}></path>
    </svg>
  </div>
  <div class="space-y-2.5">
    <h3 class="font-display text-xl text-ink-800">{title}</h3>
    <p class="text-[0.95rem] leading-relaxed text-ink-600">{description}</p>
  </div>
</div>
