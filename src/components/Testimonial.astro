---
import PlaceholderImage from './PlaceholderImage.astro';

interface Props {
  name: string;
  role: string;
  quote: string;
  tone?: 'sun' | 'sky' | 'leaf';
}
const { name, role, quote, tone = 'sun' } = Astro.props;
---

<figure class="card card-hover flex h-full flex-col gap-5 p-7 sm:p-8">
  <svg viewBox="0 0 40 32" class="h-8 w-10 text-gold-500" fill="currentColor" aria-hidden="true">
    <path d="M0 32V18C0 8.5 5.3 2 15 0l2 5C11.6 6.8 9 10 8.7 14H16v18H0zm24 0V18C24 8.5 29.3 2 39 0l1 5c-5.4 1.8-8 5-8.3 9H40v18H24z" />
  </svg>
  <blockquote class="flex-1 font-display text-[1.35rem] leading-snug text-ink-800">
    {quote}
  </blockquote>
  <figcaption class="flex items-center gap-3.5 border-t border-ink-800/10 pt-5">
    <PlaceholderImage tone={tone} label={name} kind="general" hideLabel class="h-12 w-12 shrink-0 rounded-full ring-1 ring-ink-800/10" />
    <div>
      <p class="font-semibold text-ink-800">{name}</p>
      <p class="text-sm text-ink-500">{role}</p>
    </div>
  </figcaption>
</figure>
