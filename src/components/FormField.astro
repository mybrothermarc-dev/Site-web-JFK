---
interface Option {
  value: string;
  label: string;
}
interface Props {
  label: string;
  name: string;
  type?: 'text' | 'email' | 'tel' | 'textarea' | 'select';
  required?: boolean;
  options?: Option[];
  placeholder?: string;
  rows?: number;
}
const { label, name, type = 'text', required = true, options = [], placeholder, rows = 4 } = Astro.props;
const id = `field-${name}`;
---

<div>
  <label for={id} class="mb-1.5 block text-sm font-semibold text-night">
    {label} {required && <span class="text-sun-600" aria-hidden="true">*</span>}
  </label>

  {type === 'textarea' && (
    <textarea
      id={id}
      name={name}
      required={required}
      rows={rows}
      placeholder={placeholder}
      class="w-full rounded-lg border border-night/15 px-4 py-2.5 text-night shadow-sm focus:border-sky-500 focus:ring-sky-500"
    ></textarea>
  )}

  {type === 'select' && (
    <select
      id={id}
      name={name}
      required={required}
      class="w-full rounded-lg border border-night/15 bg-white px-4 py-2.5 text-night shadow-sm focus:border-sky-500 focus:ring-sky-500"
    >
      {options.map((opt) => (
        <option value={opt.value}>{opt.label}</option>
      ))}
    </select>
  )}

  {type !== 'textarea' && type !== 'select' && (
    <input
      id={id}
      type={type}
      name={name}
      required={required}
      placeholder={placeholder}
      class="w-full rounded-lg border border-night/15 px-4 py-2.5 text-night shadow-sm focus:border-sky-500 focus:ring-sky-500"
    />
  )}
</div>
